<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1: broadest API surface loadable by the game's Unity Mono runtime under BepInEx 5 -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Repainted</AssemblyName>
    <RootNamespace>Repainted</RootNamespace>
    <OutputPath>build/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Don't pull in default references - we reference game DLLs directly -->
    <NoStandardLibraries>false</NoStandardLibraries>

    <!-- Suppress warnings about referencing assemblies with different target frameworks -->
    <NoWarn>$(NoWarn);CS1701;CS1702</NoWarn>
  </PropertyGroup>

  <!-- Embed UI assets (icon, etc) directly into the DLL so a single file deploy works -->
  <ItemGroup>
    <EmbeddedResource Include="assets/paletteIcon.png">
      <LogicalName>Repainted.assets.paletteIcon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets/previews/Repainted_BottomTopStripe.png">
      <LogicalName>Repainted.assets.previews.Repainted_BottomTopStripe.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets/previews/Repainted_Trim.png">
      <LogicalName>Repainted.assets.previews.Repainted_Trim.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets/previews/Repainted_HighStripe.png">
      <LogicalName>Repainted.assets.previews.Repainted_HighStripe.png</LogicalName>
    </EmbeddedResource>
    <!-- Curated decal art + grout preserve layers (baked by
         assets/decalmasks/bake_masks.py). Wildcard include: the default
         manifest name (RootNamespace + dotted path) matches what the
         loaders expect, and builds still succeed if the PNGs are absent
         (e.g. building from the public repo, which excludes game-derived
         art) — the mod then falls back to the runtime pixel diff. -->
    <EmbeddedResource Include="assets/decalmasks/*.png" />
    <!-- Palette model AssetBundle, embedded for single-file installs.
         Refreshed from the Unity project by the release checklist; a
         loose repainted_palette file next to the DLL overrides it (dev
         iteration / user model swaps). -->
    <EmbeddedResource Include="assets/palette/repainted_*" />
  </ItemGroup>

  <!-- Game + BepInEx reference assemblies (none of these should be copied to output) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>lib/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>lib/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>lib/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>lib/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>lib/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>lib/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>lib/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>lib/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>lib/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>lib/UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>lib/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DOTween">
      <HintPath>lib/DOTween.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>lib/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>lib/UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>lib/UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>lib/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>lib/Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Coffee.UIEffect">
      <HintPath>lib/Coffee.UIEffect.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>


</Project>
